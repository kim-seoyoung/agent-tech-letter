{#- US0024 shared deep-dive component.
    Context: dd (DeepDive with .body_html precomputed), colors, font, layout.
    Optional: is_first (parent drops the divider on the first item),
              dd_index (parent's 1-based loop index → "DEEP DIVE 0N" kicker).
    Both web (html_web) and email (html_email) include this partial. -#}
{%- set _first = is_first|default(true) -%}
{%- set _idx = dd_index|default(0) -%}
{%- if dd.maturity == "production-ready" -%}
  {%- set _mat_fg = colors.mat_prod_fg -%}{%- set _mat_bg = colors.mat_prod_bg -%}
{%- elif dd.maturity == "beta" -%}
  {%- set _mat_fg = colors.mat_beta_fg -%}{%- set _mat_bg = colors.mat_beta_bg -%}
{%- elif dd.maturity == "experimental" -%}
  {%- set _mat_fg = colors.mat_exp_fg -%}{%- set _mat_bg = colors.mat_exp_bg -%}
{%- else -%}
  {%- set _mat_fg = colors.muted -%}{%- set _mat_bg = colors.tag_bg -%}
{%- endif -%}
<section class="deep-dive" style="margin: 0; padding-top: {% if _first %}0{% else %}48px{% endif %}; margin-top: {% if _first %}0{% else %}48px{% endif %}; border-top: {% if _first %}none{% else %}1px solid {{ colors.border }}{% endif %};">
  <p class="dd-index" style="font-family: {{ font.mono }}; font-size: {{ font.size_meta }}; letter-spacing: 0.14em; text-transform: uppercase; color: {{ colors.accent }}; margin: 0 0 12px 0;">DEEP DIVE{% if _idx %} {{ '%02d'|format(_idx) }}{% endif %}</p>
  <h2 style="font-size: {{ font.size_h2 }}; font-weight: 700; color: {{ colors.fg }}; margin: 0 0 14px 0; line-height: 1.35; letter-spacing: -0.01em;">{{ dd.title }}</h2>
  <p class="tags" style="margin: 0 0 22px 0; font-family: {{ font.mono }}; font-size: {{ font.size_meta }};">
    <span class="tag" style="background: {{ colors.tag_bg }}; color: {{ colors.muted }}; padding: 2px 8px; border-radius: 4px; font-size: 12px;">{{ dd.item_kind }}</span>
    {% if dd.maturity %}<span class="tag" style="background: {{ _mat_bg }}; color: {{ _mat_fg }}; padding: 2px 8px; border-radius: 4px; font-size: 12px;">{{ dd.maturity }}</span>{% endif %}
  </p>
  <div class="body" style="color: {{ colors.fg }}; font-family: {{ font.serif }}; font-size: {{ font.size_body }}; line-height: 1.78;">{{ dd.body_html|safe }}</div>
  {% if dd.sources %}
  <p class="sources" style="margin: 22px 0 0 0; padding-top: 14px; border-top: 1px dashed {{ colors.border }}; font-family: {{ font.mono }}; font-size: 12px; line-height: 1.9; color: {{ colors.muted }};">
    <span style="text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; color: {{ colors.faint }};">관련 출처</span>
    {% for s in dd.sources %}&nbsp;&nbsp;<a href="{{ s.url }}" style="color: {{ colors.muted }}; border-bottom: 1px solid {{ colors.border }};">{{ s.label }}</a>{% endfor %}
  </p>
  {% elif dd.show_primary|default(true) %}
  <p class="sources" style="margin: 22px 0 0 0; padding-top: 14px; border-top: 1px dashed {{ colors.border }}; font-family: {{ font.mono }}; font-size: 12px; color: {{ colors.muted }};">
    <a href="{{ dd.primary_url }}" style="color: {{ colors.accent }};">원문 ↗</a>
  </p>
  {% endif %}
</section>
